[program:sham-cash-bridge]
command=node /var/www/store-app/sham-bridge/server.js
directory=/var/www/store-app/sham-bridge
user=www-data
autostart=true
autorestart=true
startretries=3
stopwaitsecs=10
stderr_logfile=/var/log/sham-cash-bridge.err.log
stdout_logfile=/var/log/sham-cash-bridge.out.log
environment=
    PORT="3001",
    SESSION_DIR="/var/www/store-app/sham-bridge/sessions",
    LARAVEL_WEBHOOK="http://127.0.0.1/api/sham-cash/webhook",
    WEBHOOK_SECRET="your-secret-here",
    MONITOR_INTERVAL="15000"
